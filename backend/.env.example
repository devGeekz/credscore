PORT=8000
ENVIRONMENT=development
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/credscore?sslmode=require
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:8000
WEBHOOK_SIGNING_SECRET=change-me

# Object storage (leave STORAGE_BUCKET empty to write to backend/storage/ locally)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Dev without Redis: RATE_LIMIT_STORAGE_URI=memory://
