PORT=8000
ENVIRONMENT=development
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/credscore?sslmode=require
REDIS_URL=redis://localhost:6379
# set to memory:// in dev when redis isn't running; empty = use redis_url
RATE_LIMIT_STORAGE_URI=memory://
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=60m
REFRESH_EXPIRES_IN=7d
APP_URL=http://localhost:8000
# frontend origin for password-reset links
WEB_URL=http://localhost:3000
# comma-separated; empty in dev = http://localhost:3000
CORS_ORIGINS=
# optional; leave empty to disable Sentry
SENTRY_DSN=
WEBHOOK_SIGNING_SECRET=change-me

# Object storage (leave STORAGE_BUCKET empty to write to backend/storage/ locally)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# WhatsApp cloud API (optional; webhook verify token still required for GET verify)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# password-reset email delivery (empty SMTP_HOST logs the link instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@credscore.app
